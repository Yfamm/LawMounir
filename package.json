{
  "name": "law-firm-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "cms:seed": "tsx scripts/cms/seed.ts",
    "cms:create-admin": "tsx scripts/cms/create-admin.ts",
    "db:start": "supabase start -x realtime,imgproxy,edge-runtime,logflare,vector,supavisor,studio,postgres-meta,mailpit",
    "db:reset": "supabase db reset",
    "cms:backfill-ar": "tsx scripts/cms/backfill-ar.ts",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@vinext/cloudflare": "^1.1.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "server-only": "^0.0.1",
    "vinext": "^1.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.37",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "postcss": "^8.5.30",
    "supabase": "^2.118.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.4",
    "vite-css-modules": "^1.16.0",
    "wrangler": "^4.151.0"
  },
  "type": "module"
}
