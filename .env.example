# Copy to .env.local for development; set the same variables in the hosting
# platform for production. Never commit real values.

# --- Site -------------------------------------------------------------------
# Canonical origin (also editable in Admin → Site Settings, which wins when set).
NEXT_PUBLIC_SITE_URL=https://www.example.com
# Set to true at launch to allow search-engine indexing.
NEXT_PUBLIC_SITE_INDEXABLE=false

# --- Supabase ---------------------------------------------------------------
# Project URL and anon (public) key. The anon key is safe in the browser; RLS
# limits it to published content.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Used to store public enquiries, rate limiting and the CLI
# scripts. Never prefix with NEXT_PUBLIC_ and never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Random secret used to hash client IPs for rate limiting (e.g. `openssl rand -hex 32`).
RATE_LIMIT_SALT=

# --- Enquiry notifications (optional) ---------------------------------------
# After an enquiry is stored, a short notice (name + admin link, no message
# body) is e-mailed through Resend. Leave empty to disable. Enquiries are
# always stored whether or not the e-mail succeeds.
RESEND_API_KEY=
# Firm address(es) to notify, comma-separated.
CONTACT_NOTIFICATION_EMAIL=
# Verified sender, e.g. "DIWAN Website <website@your-domain>".
CONTACT_FROM_EMAIL=

# --- Local development only ---------------------------------------------------
# Lets next/image optimise uploads served by a local Supabase on 127.0.0.1.
# IMAGES_ALLOW_LOCAL_IP=true
